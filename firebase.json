{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "backend",
          "region": "us-central1"
        }
      },
        {
          "source": "/health",
          "run": {
            "serviceId": "backend",
            "region": "us-central1"
          }
         },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
